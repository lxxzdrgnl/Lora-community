# RDS MySQL 연결 설정
# AWS Elastic Beanstalk 환경 변수 설정

option_settings:
  aws:elasticbeanstalk:application:environment:
    # RDS 데이터베이스 연결 정보
    # ⚠️ 실제 값은 AWS EB 콘솔에서 직접 설정하세요!
    # DB_HOST, DB_USERNAME, DB_PASSWORD는 AWS EB 콘솔의 Environment Properties에서 설정
    DB_PORT: 3306
    DB_NAME: loradb

    # ⚠️ 아래 환경변수는 AWS EB 콘솔 → Configuration → Software → Environment Properties에서 직접 설정하세요!
    #
    # 필수 환경변수 목록:
    # - DB_HOST: RDS 엔드포인트 (예: blueming-database.xxx.rds.amazonaws.com)
    # - DB_USERNAME: RDS 사용자명 (예: admin)
    # - DB_PASSWORD: RDS 비밀번호
    # - JWT_SECRET: JWT 서명 키
    # - GOOGLE_CLIENT_ID: Google OAuth2 클라이언트 ID
    # - GOOGLE_CLIENT_SECRET: Google OAuth2 클라이언트 시크릿
    # - FRONTEND_URL: 프론트엔드 URL (예: https://blueming-ai.vercel.app)
    # - FASTAPI_URL: FastAPI 서버 URL (예: https://xxx.modal.run)
