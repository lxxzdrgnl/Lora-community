# Database Configuration
# Docker Compose: DB_HOST=db (서비스명)
# 로컬 개발: DB_HOST=localhost
DB_HOST=db
DB_PORT=3306
DB_NAME=blooming
DB_USERNAME=root
DB_PASSWORD=your-mysql-root-password

# Redis Configuration
# Docker Compose: REDIS_HOST=redis (서비스명)
# 로컬 개발: REDIS_HOST=localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# JWT Authentication (256비트 이상 랜덤 문자열)
JWT_SECRET=your-jwt-secret-key-minimum-256-bits-required

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-firebase-private-key-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-firebase-private-key\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-firebase-client-id

# Frontend & Backend URLs
FRONTEND_URL=https://blueming.rheon.kr
CALLBACK_URL=https://api-blueming.rheon.kr

# CORS Configuration
CORS_ORIGINS=https://blueming.rheon.kr

# MinIO / S3 Configuration
# AWS_S3_ENDPOINT: Docker 내부 MinIO 통신 (http://minio:9000)
# AWS_S3_PUBLIC_ENDPOINT: 브라우저에서 접근하는 MinIO URL (presigned URL 생성에 사용)
AWS_ACCESS_KEY_ID=your-minio-access-key
AWS_SECRET_ACCESS_KEY=your-minio-secret-key
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT=https://storage.rheon.kr
AWS_S3_REGION=us-east-1
AWS_S3_TRAINING_BUCKET=lora-training-data
AWS_S3_MODELS_BUCKET=lora-models
AWS_S3_GENERATED_BUCKET=lora-generated-images

# FastAPI / Modal Service
FASTAPI_URL=https://your-modal-app.modal.run

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Server Port
SERVER_PORT=8080
