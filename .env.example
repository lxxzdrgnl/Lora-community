# Database Configuration (RDS MySQL)
DB_HOST=your-database-host.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=loradb
DB_USERNAME=admin
DB_PASSWORD=your-database-password

# Redis Configuration (Upstash Redis)
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_SSL_ENABLED=true

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-minimum-256-bits-required

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend & Backend URLs
FRONTEND_URL=https://your-frontend-cloudfront-url.cloudfront.net
CALLBACK_URL=https://your-backend-cloudfront-url.cloudfront.net

# CORS Configuration
CORS_ORIGINS=https://your-frontend-cloudfront-url.cloudfront.net

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_REGION=ap-northeast-2
AWS_S3_TRAINING_BUCKET=lora-training-data-bucket
AWS_S3_MODELS_BUCKET=lora-models-bucket
AWS_S3_GENERATED_BUCKET=lora-generated-image-bucket

# FastAPI/Modal Service
FASTAPI_URL=https://your-modal-app.modal.run

# Optional: Spring Profile (prod/local)
SPRING_PROFILES_ACTIVE=prod
